name = "bobzhang/issues"

version = "0.1.8"

import {
  "moonbit-community/rabbita@0.12.3",
  "moonbitlang/async@0.22.4",
  "moonbitlang/x@0.5.5",
  "moonbit-community/cmark@0.4.8",
  "moonbit-community/casefold@0.1.7",
